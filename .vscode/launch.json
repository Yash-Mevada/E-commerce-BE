{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (tsx watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "watch",
        "src/index.ts"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "env": {
        "NODE_OPTIONS": "--no-network-family-autoselection"
      }
    }
  ]
}
