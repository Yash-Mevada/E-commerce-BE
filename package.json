{
  "name": "e-commerce-be",
  "version": "1.0.0",
  "description": "developing backend for E-commerce app",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--no-network-family-autoselection $NODE_OPTIONS\" tsx watch src/index.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS=\"--no-network-family-autoselection $NODE_OPTIONS\" node dist/index.js",
    "migrate:users": "NODE_OPTIONS=\"--no-network-family-autoselection $NODE_OPTIONS\" tsx src/scripts/migrate_users.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ExpressJs",
    "PostgreSQL"
  ],
  "author": "Yash-Mewara",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1096.0",
    "@aws-sdk/client-s3": "^3.1097.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.18.0",
    "razorpay": "^2.9.8",
    "resend": "^6.9.3",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
